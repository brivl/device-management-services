{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@dms/common/types": ["../common/src/types.ts"],
      "@dms/common/users": ["../common/src/users.ts"]
    }
  },
  "include": ["src", "tests"]
}
